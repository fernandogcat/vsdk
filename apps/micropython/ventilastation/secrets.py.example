# Per-board local config. Copy to `secrets.py` (gitignored) ONLY on a dev board you want
# in mirror mode: it streams the display to the desktop emulator over WiFi instead of
# driving the POV LEDs (see platforms/mirror.py). Fan boards must not have secrets.py.

MIRROR = True
# 2.4 GHz networks in priority order (first visible one wins):
WIFI_NETWORKS = [
    ("your-home-ssid", "your-password"),
    ("your-phone-hotspot", "hotspot-password"),
]
